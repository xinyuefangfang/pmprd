{
  "name": "prototype-prd-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite --config prd-kit/vite.config.ts",
    "build": "vite build --config prd-kit/vite.config.ts",
    "check": "tsc --noEmit && tsc --noEmit -p prd-kit/tsconfig.json",
    "test": "node --experimental-strip-types prd-kit/prd-kit.test.ts && node --experimental-strip-types src/preview/store.test.ts",
    "validate:prd": "node --experimental-strip-types prd-kit/validator/cli.ts",
    "demo:annotations": "node scripts/demo-docs.mjs annotated",
    "demo:baseline": "node scripts/demo-docs.mjs baseline"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "streamdown": "2.5.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
